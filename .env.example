# Neon Serverless PostgreSQL
# Obtenha em: https://neon.tech > seu projeto > Connection Details
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Telegram Bot
# 1. Abra o Telegram e fale com @BotFather
# 2. Envie /newbot e siga as instruções
# 3. Copie o token gerado
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID do grupo privado (Henrique + Josiane)
# 1. Adicione o bot ao grupo
# 2. Envie uma mensagem no grupo
# 3. Acesse: https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Procure o campo "chat" > "id" (será negativo para grupos, ex: -100xxxxxxxxxx)
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
